# --- Build output (regenerate with `npm run build` / `python tools/package.py`) ---
/dist/
/release/

# --- Scraper ---
# On-disk HTTP cache (~77 MB, rebuilt by scraper/scrape.py)
/scraper/cache/
*.log

# --- Local server config (machine-specific paths) ---
/api/config.php

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
*.local

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- SQLite temp files ---
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (keep shared launch.json, ignore personal settings) ---
.claude/settings.local.json
